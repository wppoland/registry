#. Plugin Name of the plugin
#: registry.php
msgid "Registry - Gift Registry for WooCommerce"
msgstr "Registro - Registro de regalos para WooCommerce"

#. Plugin URI of the plugin
#: registry.php
msgid "https://plogins.com/registry/"
msgstr "https://plogins.com/es/registry/"

#. Description of the plugin
#: registry.php
msgid ""
"Let customers create shareable gift registries for weddings, baby showers "
"and events."
msgstr ""
"Permita que los clientes creen registros de regalos compartibles para bodas, "
"baby showers y eventos."

#. Author of the plugin
