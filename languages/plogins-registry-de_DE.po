#. Plugin Name of the plugin
#: registry.php
msgid "Registry - Gift Registry for WooCommerce"
msgstr "Registry, Geschenkliste für WooCommerce"

#. Plugin URI of the plugin
#: registry.php
msgid "https://plogins.com/registry/"
msgstr "https://plogins.com/de/registry/"

#. Description of the plugin
#: registry.php
msgid ""
"Let customers create shareable gift registries for weddings, baby showers "
"and events."
msgstr ""
"Ermögliche deinen Kunden, gemeinsam nutzbare Geschenklisten für Hochzeiten, "
"Babypartys und Veranstaltungen zu erstellen."

#. Author of the plugin
#: registry.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
